FROM vllm/vllm-openai:latest

# Token Factory analogue: merged HF checkpoint baked or mounted at /models/toolace
ENV MODEL_PATH=/models/llama-3.1-8b-toolace
ENV SERVED_MODEL_NAME=llama-3.1-8b-toolace

EXPOSE 8000

CMD ["sh", "-c", "vllm serve ${MODEL_PATH} --served-model-name ${SERVED_MODEL_NAME} --host 0.0.0.0 --port 8000 --dtype bfloat16 --max-model-len 8192 --gpu-memory-utilization 0.9 --max-num-seqs 64 --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser llama3_json"]
